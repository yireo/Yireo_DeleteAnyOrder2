{
    "name": "yireo/magento2-deleteanyorder2",
    "version": "1.0.8",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "homepage": "https://www.yireo.com/software/magento-extensions/delete-any-order-2",
    "description": "Delete any Magento order safely from the database",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "magento/framework": "^101.0.1|^101.0|^102.0|^103.0",
        "magento/framework-message-queue": "^100.2",
        "magento/module-backend": "^100.2|^101.0|^102.0",
        "magento/module-sales": "^101.0|^102.0|^103.0",
        "magento/module-store": "^100.2|^101.0",
        "magento/module-ui": "^101.0",
        "monolog/monolog": "^2.0 || ^3.0",
        "php": ">=8.2 <8.6",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "suggest": {
        "magento/module-inventory-reservations": "Deleting an order also deletes its MSI reservations"
    },
    "require-dev": {
        "loki/magento2-functional-tests": "@dev",
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\DeleteAnyOrder2\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "archive": {
        "exclude": [
            "/Test",
            "/.github",
            "/phpunit.xml.dist",
            "/ci-details",
            "/.module.ini"
        ]
    }
}